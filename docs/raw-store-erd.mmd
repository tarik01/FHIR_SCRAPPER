erDiagram
    direction LR
    export_jobs ||--o{ export_files : "lists (manifest output[])"
    export_files ||--o{ raw_resources : "contains (1 line = 1 resource)"

    export_jobs {
        text job_id PK "from Content-Location"
        text source_base_url
        text request_url "$export?_type=Patient,Observation"
        text poll_url "resume point"
        text since "null on full export"
        text status "in_progress | completed | failed | expired"
        text transaction_time "cut-off, next _since"
        json expected_counts "_summary=count le transaction_time"
        json manifest_json "manifest as received"
        datetime kicked_off_at
        datetime completed_at
        text last_error
    }

    export_files {
        int id PK
        text job_id FK
        text resource_type "Patient | Observation"
        text url UK "Binary/... (unique per job)"
        text status "pending | done | failed"
        int attempts
        int http_status
        text last_error
        int line_count "lines in file"
        int inserted_count "new versions"
        int duplicate_count "already stored"
        text sha256
        datetime downloaded_at
    }

    raw_resources {
        int id PK
        text resource_type UK "unique (type, source_id, version_id)"
        text source_id UK "FHIR id"
        text version_id UK "meta.versionId"
        text last_updated "meta.lastUpdated"
        text payload "NDJSON line, untouched"
        text payload_sha256
        int file_id FK "source file (first seen)"
        int line_no
        datetime extracted_at
    }
